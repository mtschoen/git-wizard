<Project>

  <!-- Repo-wide analyzer + code-style baseline for the git-wizard solution.
       Applies to every project under this directory (the 4 git-wizard projects
       + tests). MFTLib lives outside this tree and is unaffected.

       <TreatWarningsAsErrors> is set below: the build is the analyzer gate. -->

  <PropertyGroup>
    <Version>0.4.1</Version>
    <!-- Make the SDK (CA*/IDE*) analyzer set explicit and pick up the full
         recommended ruleset rather than the SDK default subset. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <!-- Enforce .editorconfig code-style (IDE* rules) as build diagnostics. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Findings are at zero, so the build is now the gate. MFTLib (outside this
         tree) does not inherit this and keeps its warnings as warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslynator rules are disabled by default. .editorconfig enables a curated,
         explicitly pinned subset (RCS1161, RCS1168, RCS1238) so package upgrades
         cannot add surprise build failures. TreatWarningsAsErrors gates that subset;
         all other RCS rules remain off. Pinned for reproducibility. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
