<Project>

  <!-- Repo-wide analyzer + code-style baseline for the git-wizard solution.
       Applies to every project under this directory (the 4 git-wizard projects
       + tests). MFTLib lives outside this tree and is unaffected.

       <TreatWarningsAsErrors> is set below: the build is the analyzer gate. -->

  <PropertyGroup>
    <Version>0.4.1</Version>
    <!-- Make the SDK (CA*/IDE*) analyzer set explicit and pick up the full
         recommended ruleset rather than the SDK default subset. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <!-- Enforce .editorconfig code-style (IDE* rules) as build diagnostics. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Findings are at zero, so the build is now the gate. MFTLib (outside this
         tree) does not inherit this and keeps its warnings as warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Linux CI restores in locked mode against the per-host NuGet cache, which
         makes a warm restore silent (zero nuget.org requests). The lock files are
         generated on Linux, so Windows is excluded: its restore would otherwise
         rewrite them and dirty the tree; NuGet still reads an existing lock file at NuGetLockFilePath even when RestorePackagesWithLockFile is unset, so redirect Windows to obj/ where none exists (schoen-lab#3353). -->
    <RestorePackagesWithLockFile Condition="'$(OS)' != 'Windows_NT'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(OS)' == 'Windows_NT'">$(MSBuildProjectDirectory)\obj\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslynator rules are disabled by default. .editorconfig enables a curated,
         explicitly pinned subset (RCS1001, RCS1003, RCS1161, RCS1168, RCS1238, RCS1249) so package upgrades
         cannot add surprise build failures. TreatWarningsAsErrors gates that subset;
         all other RCS rules remain off. Pinned for reproducibility.
         EnforceIfStatementBraces and UseCollectionExpression are jb-native pins in .editorconfig;
         NUnit2045/NUnit2056 are test-only NUnit.Analyzers pins there, not Roslynator rules. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
