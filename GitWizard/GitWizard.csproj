<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <!-- MFTLib (0.3.0) is referenced centrally for the whole tree in the repo-root
         Directory.Build.targets — a TEMPORARY source-build bridge to the external/MFTLib
         submodule while 0.3.0 is unpublished. See Directory.Build.targets' header for the
         retire-to-NuGet steps, and AGENTS.md's MFTLib Local Development section for local dev. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the test project: the pure ScanRecord-to-repository-root mapping
         seam (SelectGitEntryPaths, ResolveRepositoryRootCandidates) so the .git-file discovery
         path can be exercised with synthetic ScanRecords on any OS, and the broker discovery
         profile/keep-file-name constants so the wire-level ArmAndScan assertion can reuse them
         instead of repeating literals. -->
    <InternalsVisibleTo Include="GitWizardTests" />
  </ItemGroup>
</Project>
