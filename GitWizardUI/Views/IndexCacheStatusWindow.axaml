<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitWizardUI.ViewModels"
        x:Class="GitWizardUI.Views.IndexCacheStatusWindow"
        x:DataType="vm:IndexCacheStatusViewModel"
        Title="Index Cache Status" Width="850" Height="600"
        MinWidth="500" MinHeight="300">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <Button x:Name="RefreshStatusButton" Content="Refresh status"
            IsEnabled="{Binding CanRefresh}" Click="RefreshStatus_Click" />
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="Live volume readiness" FontWeight="SemiBold" />
        <ItemsControl x:Name="IndexCacheLiveVolumeList" ItemsSource="{Binding LiveVolumes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LiveVolumeStatusViewModel">
              <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="14" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock x:Name="CacheStatusText" Text="{Binding Text}"
                             TextWrapping="Wrap" FontSize="14" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
